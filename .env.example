# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Values come from the Supabase dashboard: Project Settings -> API Keys.
# Use the *staging* project locally; production values live only in Vercel.

# Your project's URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "publishable" key (sb_publishable_...). This one is PUBLIC by design —
# it ships in the browser bundle and is safe in CI config. Access is controlled
# by row-level security in Postgres, not by hiding this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NOTE: there is deliberately no SUPABASE_SECRET_KEY here.
# The secret key (sb_secret_...) bypasses row-level security entirely, so it is
# never given to this app. The only thing that needs it is the invite Edge
# Function, which runs inside Supabase where the key is injected automatically.
# If you find yourself wanting to add it here, something has gone wrong.
